{
  "schema": "cellular-mode/component-manifest",
  "version": 1,
  "id": "method-core",
  "componentVersion": "1.1.0",
  "description": "The method itself: a generated AGENTS.md, the cell, pause, operation and worker skills, and an empty vault/state skeleton.",
  "files": [
    { "target": "AGENTS.md", "mode": "generate", "template": "agents-md" },
    { "source": "skills/cell/", "target": "skills/cell/", "mode": "copy" },
    { "source": "skills/pause/", "target": "skills/pause/", "mode": "copy" },
    { "source": "skills/operation/", "target": "skills/operation/", "mode": "copy" },
    { "source": "skills/worker/", "target": "skills/worker/", "mode": "copy" },
    { "target": "vault/state/", "mode": "generate", "template": "vault-skeleton" }
  ],
  "exclude": [],
  "dependsOn": [],
  "optionalDependsOn": [],
  "conflicts": [],
  "host": { "requires": [] },
  "config": [],
  "verify": [],
  "uninstall": "remove-owned"
}
